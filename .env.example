# =============================================================================
# Copy to .env and fill in. .env is gitignored.
# Generate hash with:  openssl passwd -6 'your-strong-password'
# IMPORTANT: wrap values containing $ in SINGLE quotes (bash expands $6, $1 etc)
# =============================================================================

# Public domain (after NPM hookup) — used in docs / share.sh fallback
BASE_DOMAIN=files.example.com

# Admin user (HTTP Basic Auth)
ADMIN_USER=admin

# SHA-512 hash of admin password (must start with $6$)
# Generate:  openssl passwd -6 'your-strong-password'
ADMIN_PASS_HASH='$6$REPLACE_WITH_OPENSSL_PASSWD_6_OUTPUT'

# Plaintext admin password (used by share.sh / test.sh — keep this file 600)
ADMIN_PASS='replace-with-strong-password'

# Host UID:GID that owns ./data (run `id -u`, `id -g` on host)
HOST_UID=502
HOST_GID=20

# Loopback ports (do NOT change to 0.0.0.0 — keep loopback only)
PUBLIC_PORT=5001
ADMIN_PORT=5002
